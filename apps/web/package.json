{
  "name": "@feito/web",
  "version": "0.5.0-beta",
  "private": true,
  "scripts": {
    "dev": "node scripts/build-sqlite.mjs --dev && next dev --experimental-https --hostname 127.0.0.1",
    "dev:container": "node scripts/build-sqlite.mjs --dev && next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build && node scripts/build-offline.mjs",
    "build:tools": "node scripts/build-tools.mjs",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "node --conditions=react-server node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --conditions=react-server --import=tsx scripts/migrate.ts",
    "keys": "node --conditions=react-server --import=tsx scripts/keys.ts",
    "admin": "node --conditions=react-server --import=tsx scripts/admin.ts",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run tests/unit tests/integration --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@feito/core": "workspace:*",
    "@feito/ui": "workspace:*",
    "@js-temporal/polyfill": "0.5.1",
    "@node-rs/argon2": "2.2.2",
    "better-auth": "1.7.25",
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@sqlite.org/sqlite-wasm": "3.54.1-build1",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "~5.9.3",
    "vitest": "5.1.0"
  }
}
