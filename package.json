{
  "name": "feito-monorepo",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": { "node": ">=24 <25", "pnpm": ">=10 <11" },
  "scripts": {
    "dev": "pnpm --filter @feito/web dev",
    "dev:desktop": "pnpm --filter @feito/desktop tauri dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter @feito/web db:generate",
    "db:migrate": "pnpm --filter @feito/web db:migrate",
    "admin": "pnpm --filter @feito/web admin",
    "keys": "pnpm --filter @feito/web keys",
    "test:integration": "pnpm --filter @feito/web test:integration",
    "test:coverage": "pnpm --filter @feito/web test:coverage",
    "test:e2e": "pnpm --filter @feito/web test:e2e"
  }
}
